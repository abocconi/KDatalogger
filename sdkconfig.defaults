# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) Project Minimal Configuration
#
CONFIG_TINYUSB_MSC_ENABLED=y
# 8 KB per USB transfer instead of 512 B: WL performance mode erases the flash
# sectors a write fully covers directly, and read-modify-writes only the
# partial ones at the edges -- with 512 B every write rewrote a whole 4 KB
# sector. Keep it a multiple of CONFIG_WL_SECTOR_SIZE.
# Safe ONLY with components/storage/wl_page_split.c: esp_tinyusb hands the
# whole buffer to wl_read()/wl_write() at a 512 B-aligned address, and WL_Flash
# (IDF 6.1) maps a range crossing a 4 KB page wrongly (stale reads, lost
# writes). The wrapper splits at page boundaries; without it this must be 512.
CONFIG_TINYUSB_MSC_BUFSIZE=8192

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_WL_SECTOR_SIZE_512=y
CONFIG_WL_SECTOR_MODE_PERF=y

# PSRAM: ESP32-S3-WROOM-1-N8R2 mounts 2MB Quad SPI PSRAM (not Octal)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_USE_MALLOC=y

CONFIG_FATFS_LFN_HEAP=y

# Firmware update from the USB volume (components/fw_update): a new image
# boots pending verification and is rolled back by the bootloader if it
# resets before app_controller's self-test confirms it.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# app_main hosts the controller loop, which runs the update: FATFS, OTA
# writes and image verification on top of the boot-time init.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# On chips with USB Serial JTAG, disable secondary console which does not make sense when using console component
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# The GUI draws with its own Barlow faces (components/gui/assets/fonts,
# see kdl_theme.h). Montserrat 14 stays only as LVGL's LV_FONT_DEFAULT.
CONFIG_LV_FONT_MONTSERRAT_14=y
